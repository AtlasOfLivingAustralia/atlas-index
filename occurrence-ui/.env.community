# Community build profile.
#
# Run `yarn build:community` (vite build --mode community) to get the LA Community build. Vite loads
# this file on top of the deployment's own .env, so it only needs the two flags below: same code,
# same commit, no fork. Without the mode you get the ALA build, with both flags off.
#
# See https://github.com/AtlasOfLivingAustralia/atlas-index/issues/147

# Keep <script src="/config.js"> in index.html, so a deployer can change settings after the build
# without rebuilding or editing built files.
VITE_RUNTIME_CONFIG_ENABLED=true

# Include the language selector in the common header. It hides itself when only one locale is
# configured, so turning it on does not force a menu.
VITE_HEADER_LANGUAGE_SWITCHER_ENABLED=true
