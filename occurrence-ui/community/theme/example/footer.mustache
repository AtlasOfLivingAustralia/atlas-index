<footer class="example-theme-footer">
    <div class="{{containerClass}} example-theme-footer-inner">
        <p>
            <strong>Example Atlas</strong> — a bundled example theme shipped with the LA Community build of
            atlas-index, used to demonstrate runtime theming (<code>THEME_HEADER_URL</code>,
            <code>THEME_FOOTER_URL</code>, <code>THEME_CSS_URL</code> in <code>config.local.js</code>). Not
            affiliated with the Atlas of Living Australia.
        </p>
        <div class="{{loginStatus}}">
            <a href="{{loginURL}}" role="button" class="loginBtn example-theme-btn">Login</a>
            <a href="{{logoutURL}}" role="button" class="logoutBtn example-theme-btn">Logout</a>
        </div>
    </div>
</footer>
