# Used exclusively during `yarn build:playwright` and Playwright test runs.
# .env.local and .env.production are hidden by run-playwright-test.sh before the build.

VITE_HOME_URL=https://ala.org.au

VITE_ENV=playwright
VITE_APP_BASE_URL=http://localhost:5173
VITE_APP_API_URL=http://localhost:8081

VITE_APP_BIE_URL=http://localhost:8081

# Biocache — mocked
VITE_APP_BIOCACHE_URL=http://localhost:8081

# for use by atlas-admin view (images) — mocked, not exercised by these tests
VITE_APP_IMAGE_THUMBNAIL_URL=http://localhost:8081/image/proxyImageThumbnail?imageId=
VITE_APP_IMAGE_LINK_URL=http://localhost:8081/image/

; Admin role is 'ROLE_ADMIN'
VITE_ADMIN_ROLE=ROLE_ADMIN

VITE_TAXON_DESCRIPTIONS_URL=http://localhost:8082/static/taxon-descriptions

VITE_DATACITE_API_URL=http://localhost:8081/datacite

# Common UI assets from local static-server
VITE_COMMON_HEADER_HTML=http://localhost:8082/static/common/banner.mustache
VITE_COMMON_FOOTER_HTML=http://localhost:8082/static/common/footer.mustache
VITE_COMMON_CSS=http://localhost:8082/static/common/ala-combined.css
VITE_COMMON_JS=http://localhost:8082/static/common/ala-combined.js
VITE_COMMON_CONTAINER_CLASS=container-fluid
VITE_SEARCH_URL_PREFIX=https://bie.test.ala.org.au
VITE_BANNER_MESSAGES_URL=http://localhost:8082/static/common/status.json
VITE_BANNER_SCOPE=admin

# Swagger sources: a single mocked source is enough for testing the view
VITE_SWAGGER_SOURCES=mock-service|http://localhost:8081/mock-openapi.json
