{
    "all": true,
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["src/buildInfo.json", "src/vite-env.d.ts", "src/config/speciesGroupsMap.json"],
    "reporter": ["text", "lcov"],
    "report-dir": "coverage",
    "temp-dir": ".nyc_output",
    "produce-source-map": true,
    "instrument": false
}
