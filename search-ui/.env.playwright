# Used exclusively during `yarn build:playwright` and Playwright test runs.
# .env.local and .env.production are hidden by run-playwright-test.sh before the build.

# General
VITE_ENV=playwright
VITE_APP_BASE_URL=http://localhost:5173
VITE_APP_API_URL=http://localhost:8081
VITE_HOME_URL=https://ala.org.au
VITE_LOGIN_URL=https://userdetails.test.ala.org.au/myprofile
VITE_LOGO_URL=https://www.ala.org.au/app/uploads/2019/01/logo.png
VITE_AUTH_COOKIE=ALA-Auth-Test-Local=
VITE_AUTH_COOKIE_DOMAIN=localhost

# Common UI (served for real by static-server on :8082 -- do not mock)
VITE_COMMON_HEADER_HTML=http://localhost:8082/static/common/banner.mustache
VITE_COMMON_FOOTER_HTML=http://localhost:8082/static/common/footer.mustache
VITE_COMMON_CSS=http://localhost:8082/static/common/ala-combined.css
VITE_COMMON_JS=http://localhost:8082/static/common/ala-combined.js
VITE_COMMON_CONTAINER_CLASS=container-fluid
VITE_BANNER_MESSAGES_URL=http://localhost:8082/static/common/status.json
VITE_BANNER_SCOPE=species
VITE_SEARCH_URL_PREFIX=https://bie.test.ala.org.au

# search-service (mocked -- tests/mocks/apiMocks.ts)
# /v2/species, /v2/search, /v1/bie/search/auto, /session all live under VITE_APP_API_URL above

# biocache (mocked -- tests/mocks/biocacheMocks.ts) -- real domain, intercepted via page.route
VITE_APP_BIOCACHE_URL=https://biocache-ws.ala.org.au/ws
VITE_APP_BIOCACHE_UI_URL=https://biocache.ala.org.au
VITE_BIOCACHE_UI_URL=https://biocache.ala.org.au
VITE_GLOBAL_FQ=&fq=-occurrenceStatus%3Aabsent&fq=spatiallyValid%3Atrue&qualityProfile=ALA

# images (mocked -- tests/mocks/imageMocks.ts, canvas-generated PNGs)
VITE_APP_IMAGE_BASE_URL=https://images.test.ala.org.au
VITE_APP_IMAGE_THUMBNAIL_URL=https://images.test.ala.org.au/image/proxyImageThumbnail?imageId=

# static taxon content (mocked -- tests/mocks/staticContentMocks.ts)
VITE_TAXON_DESCRIPTIONS_URL=https://static.test.ala.org.au/taxon-descriptions
VITE_TAXON_TRAITS_URL=https://static.test.ala.org.au/taxon-traits
VITE_TAXON_BHL_URL=https://static.test.ala.org.au/taxon-bhl
VITE_TAXON_MAP_URL=https://static.test.ala.org.au/taxon-map
VITE_APP_AUSTRAITS_LOGO=https://static.test.ala.org.au/images/austraitslogo.png

# Other external services -- real domains, only mocked if a test clicks through;
# otherwise just used for href assertions
VITE_COLLECTIONS_URL=https://collections.ala.org.au
VITE_SPATIAL_URL=https://spatial.ala.org.au
VITE_REGIONS_URL=https://regions.ala.org.au
VITE_SPECIESLIST_URL=https://lists.ala.org.au
VITE_APP_BIOCOLLECT_URL=https://biocollect.ala.org.au
VITE_APP_DIGIVOL_URL=https://www.digivol.org.au
VITE_APP_KNOWLEDGE_BASE_URL=https://support.ala.org.au/support/home
VITE_APP_BHL_URL=https://www.biodiversitylibrary.org
VITE_CITE_URL=https://support.ala.org.au/support/solutions/articles/6000261662-citing-the-ala#website
VITE_SDS_INFO_URL=https://support.ala.org.au/support/solutions/articles/6000261705
VITE_TAXONOMY_INTRO_URL=https://support.ala.org.au/support/solutions/articles/6000271098
VITE_ALA_NATIVE_INTRODUCED_INFO_URL=https://lists.ala.org.au/list/dr22952
VITE_APP_ALERTS_URL=https://alerts.ala.org.au
VITE_APP_ALERT_RESOURCE_NAME=Atlas of Living Australia
VITE_APP_ICONIC_SPECIES_LIST=dr781
VITE_AUSTRAITS_HOME=https://austraits.org/
VITE_AUSTRAITS_DOI=https://doi.org/10.5281/zenodo.3568417
VITE_AUSTRAITS_DEFINITIONS=http://localhost:8082/static/austraits/definitions

# Map config -- Google key intentionally EMPTY (matches regions-ui convention). This means
# the interactive/Leaflet fallback map's LayersControl (base tiles + WMS overlays + legend)
# will not mount. CachedMapView (the default map) is unaffected.
VITE_GOOGLE_MAP_API_KEY=
VITE_OPENSTREETMAP_ZXY_URL=https://spatial.ala.org.au/osm/{z}/{x}/{y}.png
VITE_MAP_CENTRE_LAT=-28
VITE_MAP_CENTRE_LNG=133
VITE_MAP_DEFAULT_ZOOM=4
VITE_MAP_DEFAULT_ZOOM_MOBILE=3
VITE_MAP_LAYER_OPACITY=0.7
VITE_TAXON_MAP_ENABLED=true
VITE_TAXON_MAP_ZOOMS=aus,region
VITE_TAXON_MAP_BASE_LAYERS=base
VITE_LEAFLET_MAP_ENABLED=true
