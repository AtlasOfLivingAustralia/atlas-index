# search-service-config.properties, rendered at deploy time by cicd/backend/scripts/deploy_helm.sh
# from cicd/config.ini + cicd/backend/config.ini. Overrides src/main/resources/application.properties.
# The properties in the Secrets Manager secret {{ app_secret_name }} are appended after this.

# health endpoints for the Kubernetes probes and the post-deploy smoke test
management.endpoints.web.exposure.exclude=
management.endpoints.web.exposure.include=health
management.endpoint.health.enabled=true
management.endpoint.health.probes.enabled=true

elastic.host={{ elastic_host }}
spring.datasource.url={{ datasource_url }}
spring.datasource.username={{ datasource_username }}
rabbitmq.host={{ rabbitmq_host }}
rabbitmq.username={{ rabbitmq_username }}

security.cookie.domain={{ hosted_zone }}
security.cors.origins={{ cors_origins }}
security.oidc.discovery-uri={{ oidc_discovery_uri }}
security.oidc.clientId={{ oidc_client_id }}
security.jwt.discovery-uri={{ oidc_discovery_uri }}
security.jwt.clientId={{ oidc_client_id }}
userdetails.url={{ userdetails_url }}

openapi.servers={{ deploy_url }}
sitemap.url=https://{{ search_ui_host }}
speciesUrlPrefix=https://{{ search_ui_host }}/species/
doi.baseUrl=https://{{ doi_ui_host }}

# everything on the data volume (search-service/helm)
data.dir=/data/search-service/atlas-search
dwca.dir=/data/search-service/import-data/import
dwca.extract.leftRightCsvPath=/data/search-service/import-data/lsid-left-right.csv
dwca.extract.commonNamePath=/data/search-service/import-data/lsid-vernacularName.csv
